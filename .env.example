# Copy to .env and fill in. .env is gitignored and is never baked into the image.
#   cp .env.example .env

# Cloudflare Tunnel token, from the Zero Trust dashboard.
# Point the tunnel's public hostname at http://app:3000
TUNNEL_TOKEN=

# Where contact form messages are delivered.
# This value stays on the server. It is never sent to the browser.
CONTACT_TO=

# The envelope sender. Usually the same as SMTP_USER.
CONTACT_FROM=

# SMTP credentials for whatever provider sends the mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
